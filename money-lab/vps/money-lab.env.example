# Copy to /etc/money-lab.env, then: sudo chown root:root /etc/money-lab.env && sudo chmod 600 /etc/money-lab.env
# Never commit the real file and never paste these values in a chat.
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
TELEGRAM_BOT_TOKEN=REPLACE_ME
# Restricted, read-only Stripe key (permission: Balance / balance transactions - read). Leave empty to disable.
STRIPE_API_KEY=rk_live_REPLACE_ME

# --- Credentials the bot itself may use (visible to its shell; scope them narrowly) ---
# Fine-grained GitHub token limited to the bot's own organization (Administration, Contents, Pages:
# read and write). Leave both empty to keep publishing with the owner.
GH_TOKEN=
GITHUB_ORG=
# GoatCounter site code and a read-only API token (Read statistics).
GOATCOUNTER_SITE=
GOATCOUNTER_TOKEN=
# Google Search Console property (key in ~/.automaton/gsc-key.json, see the guide)
GSC_SITE=
# Bluesky account for the bot's posts (app password, never the account password).
# The bot cannot read the password; posts wait for /publier on Telegram.
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# --- Free AI models for collecting and extracting (harvest); the bot never sees these keys ---
# Any of them, or none (the bot then falls back to Claude Haiku, paid). See the guide.
# The runtime rotates between them within each one's free daily quota. See the guide, "IA gratuites".
GROQ_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
NVIDIA_API_KEY=
SAMBANOVA_API_KEY=
GITHUB_MODELS_TOKEN=
CLOUDFLARE_AI_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
OPENROUTER_API_KEY=
# Optional: force a model (OPENROUTER_MODEL must end in ":free"), the order, or a local Ollama model.
# GROQ_MODEL=
# GEMINI_MODEL=
# MISTRAL_MODEL=
# NVIDIA_MODEL=
# SAMBANOVA_MODEL=
# GITHUB_MODEL=
# CLOUDFLARE_AI_MODEL=
# OPENROUTER_MODEL=
# FREE_AI_ORDER=groq,gemini,mistral,nvidia,sambanova,github,cloudflare,openrouter,ollama
# Optional: a free Jina Reader key (jina.ai) raises the page-reading limit from 20 to 500 requests a minute.
JINA_API_KEY=
# MONEY_LAB_READER=direct   # read pages directly instead of through r.jina.ai
# Cloudflare Web Analytics token (dash.cloudflare.com → Analytics & Logs → Web Analytics): scaffolded sites include its snippet.
CF_WEB_ANALYTICS_TOKEN=
# MONEY_LAB_INDEXNOW_KEY=   # optional fixed IndexNow key (else derived from the site host)

# --- Free services with your accounts (step 5b); the bot never sees these keys. See the guide, "Comptes gratuits". ---
# Tavily web search for the bot's research (1,000 searches a month free; the bot uses at most 30 a day).
TAVILY_API_KEY=
# Bing Webmaster Tools API key (Settings → API access): what Bing shows for the bot's sites, URL submission.
BING_WEBMASTER_KEY=
# INSEE Sirene (portail-api.insee.fr, application key): French business counts by trade and area.
INSEE_API_KEY=
# Légifrance through PISTE (piste.gouv.fr application, OAuth client credentials). PISTE_SANDBOX=1 for the sandbox.
PISTE_CLIENT_ID=
PISTE_CLIENT_SECRET=
# dev.to API key (Settings → Extensions → DEV Community API Keys): kits for dev.to are posted by the runtime after /publie.
DEVTO_API_KEY=
# Mastodon account for the bot (instance host, e.g. piaille.fr, and an application token with write:statuses).
MASTODON_INSTANCE=
MASTODON_TOKEN=
# Resend API key and your own address: the bot e-mails you long reports (3 a day). RESEND_FROM once you verified a domain.
RESEND_API_KEY=
MONEY_LAB_OWNER_EMAIL=
# RESEND_FROM=Money Lab <bot@your-domain.fr>
# UptimeRobot Main API key (read/write): external checks of the bot's sites every 5 minutes.
UPTIMEROBOT_API_KEY=
# Cloudflare deployments and analytics: one API token with Cloudflare Pages Edit, Workers Scripts Edit, Workers KV Storage Edit,
# D1 Edit, Account Analytics Read and Account Settings Read (CLOUDFLARE_ACCOUNT_ID above is shared with Workers AI).
CLOUDFLARE_PAGES_TOKEN=
# MONEY_LAB_WRANGLER=/usr/local/bin/wrangler   # optional path; else wrangler on PATH, else npx wrangler@4
# Work modes (cents): discovery is nearly free; build uses the owner caps from automaton.json.
# MONEY_LAB_DISCOVERY_DAILY_CENTS=100
# MONEY_LAB_DISCOVERY_HOURLY_CENTS=40
# OLLAMA_MODEL=qwen2.5:3b
