# Copy to /etc/money-lab.env, then: sudo chown root:root /etc/money-lab.env && sudo chmod 600 /etc/money-lab.env
# Never commit the real file and never paste these values in a chat.
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
TELEGRAM_BOT_TOKEN=REPLACE_ME
# Restricted, read-only Stripe key (permission: Balance / balance transactions - read). Leave empty to disable.
STRIPE_API_KEY=rk_live_REPLACE_ME

# --- Credentials the bot itself may use (visible to its shell; scope them narrowly) ---
# Fine-grained GitHub token limited to the bot's own organization (Administration, Contents, Pages:
# read and write). Leave both empty to keep publishing with the owner.
GH_TOKEN=
GITHUB_ORG=
# GoatCounter site code and a read-only API token (Read statistics).
GOATCOUNTER_SITE=
GOATCOUNTER_TOKEN=
# Google Search Console property (key in ~/.automaton/gsc-key.json, see the guide)
GSC_SITE=
# Bluesky account for the bot's posts (app password, never the account password).
# The bot cannot read the password; posts wait for /publier on Telegram.
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# --- Free AI models for collecting and extracting (harvest); the bot never sees these keys ---
# Any of them, or none (the bot then falls back to Claude Haiku, paid). See the guide.
# The runtime rotates between them within each one's free daily quota. See the guide, "IA gratuites".
GROQ_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
NVIDIA_API_KEY=
SAMBANOVA_API_KEY=
GITHUB_MODELS_TOKEN=
CLOUDFLARE_AI_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
OPENROUTER_API_KEY=
# Optional: force a model (OPENROUTER_MODEL must end in ":free"), the order, or a local Ollama model.
# GROQ_MODEL=
# GEMINI_MODEL=
# MISTRAL_MODEL=
# NVIDIA_MODEL=
# SAMBANOVA_MODEL=
# GITHUB_MODEL=
# CLOUDFLARE_AI_MODEL=
# OPENROUTER_MODEL=
# FREE_AI_ORDER=groq,gemini,mistral,nvidia,sambanova,github,cloudflare,openrouter,ollama
# Work modes (cents): discovery is nearly free; build uses the owner caps from automaton.json.
# MONEY_LAB_DISCOVERY_DAILY_CENTS=100
# MONEY_LAB_DISCOVERY_HOURLY_CENTS=40
# OLLAMA_MODEL=qwen2.5:3b
